{
  "name": "ChapterAudio",
  "type": "object",
  "properties": {
    "book": {
      "type": "string",
      "description": "Full book name matching the apiName convention used across the app (e.g. 'Genesis', '1 Samuel', 'Psalms', 'Revelation')"
    },
    "book_order": {
      "type": "number",
      "minimum": 1,
      "maximum": 66,
      "description": "Canonical book order 1-66 (Genesis=1 ... Revelation=66) for sequencing narration across the whole Bible"
    },
    "chapter": {
      "type": "number",
      "description": "Chapter number (1-based)"
    },
    "audio_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to the mp3 narration file for this chapter"
    },
    "voice": {
      "type": "string",
      "description": "TTS voice identifier, e.g. 'en-GB-ThomasNeural'"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Audio duration in seconds (optional, for display)"
    },
    "verse_count": {
      "type": "number",
      "description": "Number of verses in this chapter (optional, for reference)"
    }
  },
  "required": [
    "book",
    "book_order",
    "chapter",
    "audio_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}