{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_verse_push",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyVersePush"
          },
          "then": "end",
          "x-base44": {
            "title": "Send daily verse push",
            "description": "Push today's verse to all subscribers"
          }
        }
      }
    ]
  },
  "name": "Daily Verse Push",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Asia/Singapore",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sends the daily KJB verse as a web push notification to all subscribed devices every day at 8am Singapore time."
}